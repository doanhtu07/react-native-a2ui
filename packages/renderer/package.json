{
  "name": "@the-a2ui/renderer",
  "version": "0.0.0",
  "description": "React Native A2UI renderer",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./metro": "./metro.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "metro.js",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli lib",
    "dev": "nodemon",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier",
    "check": "pnpm typecheck && prettier --write . && eslint \"**/*.{js,ts,tsx}\" --fix",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doanhtu07/react-native-the-a2ui.git"
  },
  "author": "Anh Tu Do <doanhtu07@gmail.com> (https://github.com/doanhtu07)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/doanhtu07/react-native-the-a2ui/issues"
  },
  "homepage": "https://github.com/doanhtu07/react-native-the-a2ui#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@a2ui/web_core": "^0.12.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@the-polyfills/random-uuid": "^2.0.0",
    "@types/react": "~19.2.4",
    "del-cli": "^7.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@a2ui/web_core": "*",
    "@the-polyfills/random-uuid": "*",
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@a2ui|@preact|zod|zod-to-json-schema|validate-color)/)"
    ],
    "moduleNameMapper": {
      "^@a2ui/web_core/v0_9/basic_catalog/api$": "<rootDir>/../../node_modules/@a2ui/web_core/src/v0_9/basic_catalog/components/basic_components.js",
      "^@a2ui/web_core/v0_9/basic_catalog/functions$": "<rootDir>/../../node_modules/@a2ui/web_core/src/v0_9/basic_catalog/functions/basic_functions.js",
      "^@a2ui/web_core/v0_9/basic_catalog/theme$": "<rootDir>/../../node_modules/@a2ui/web_core/src/v0_9/basic_catalog/theme.js"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.62.0"
  }
}
